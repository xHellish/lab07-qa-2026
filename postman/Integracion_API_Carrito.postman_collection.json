              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response contains a token string', function () {",
                  "  pm.expect(pm.response.json().token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Token has JWT format (three parts)', function () {",
                  "  const parts = pm.response.json().token.split('.');",
                  "  pm.expect(parts).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
