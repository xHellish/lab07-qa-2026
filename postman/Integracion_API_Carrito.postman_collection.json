    {
      "name": "Carrito",
      "description": "Creación, consulta, actualización e idempotencia del carrito. Limitación: FakeStore no persiste los carritos creados (siempre id 11).",
      "item": [
        {
          "name": "TC-06 Crear carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cart = pm.response.json();",
                  "const quantity = Number(pm.environment.get('quantity'));",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Cart has a numeric id and the right user', function () {",
                  "  pm.expect(cart.id).to.be.a('number');",
                  "  pm.expect(cart.userId).to.eql(Number(pm.environment.get('user_id')));",
                  "});",
                  "",
                  "pm.test('Cart contains the selected products', function () {",
                  "  pm.expect(cart.products).to.be.an('array').with.lengthOf(2);",
                  "  pm.expect(cart.products[0].productId).to.eql(Number(pm.environment.get('product_id')));",
                  "  pm.expect(cart.products[1].productId).to.eql(Number(pm.environment.get('product_id_2')));",
                  "});",
                  "",
                  "pm.test('Quantities are positive and match the request', function () {",
                  "  pm.expect(cart.products[0].quantity).to.eql(quantity);",
                  "  pm.expect(cart.products[1].quantity).to.eql(1);",
                  "  for (const line of cart.products) {",
                  "    pm.expect(line.quantity).to.be.above(0);",
                  "  }",
                  "});",
                  "",
                  "// La API no calcula total: se calcula aquí con los precios del catálogo",
                  "const expected_total = Number(pm.environment.get('product_price')) * quantity + Number(pm.environment.get('product_price_2'));",
                  "pm.environment.set('cart_id', cart.id);",
                  "pm.environment.set('expected_cart_total', expected_total.toFixed(2));",
                  "pm.environment.set('last_cart_response', JSON.stringify(cart));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/carts",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{user_id}},\n  \"date\": \"2026-10-18\",\n  \"products\": [\n    { \"productId\": {{product_id}}, \"quantity\": {{quantity}} },\n    { \"productId\": {{product_id_2}}, \"quantity\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
