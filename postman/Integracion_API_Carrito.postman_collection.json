                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Categories is a list of strings', function () {",
                  "  pm.expect(categories).to.be.an('array').with.lengthOf(4);",
