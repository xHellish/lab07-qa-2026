    {
      "name": "Total",
      "description": "La API no calcula totales: se calculan en Postman con los precios del catálogo.",
      "item": [
        {
          "name": "TC-08 Calcular total del carrito 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cart = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// La API no devuelve total: se consultan los precios y se calcula en Postman",
                  "pm.sendRequest(pm.environment.get('base_url') + '/products', function (error, response) {",
                  "  pm.test('Price lookup succeeded', function () {",
                  "    pm.expect(error).to.be.null;",
                  "    pm.expect(response.code).to.eql(200);",
                  "  });",
                  "",
                  "  const prices = {};",
                  "  for (const product of response.json()) {",
                  "    prices[product.id] = product.price;",
                  "  }",
                  "",
                  "  let total = 0;",
                  "  for (const line of cart.products) {",
                  "    pm.expect(prices, 'price for ' + line.productId).to.have.property(String(line.productId));",
                  "    total += prices[line.productId] * line.quantity;",
                  "  }",
                  "  total = Number(total.toFixed(2));",
                  "  pm.environment.set('seed_cart_total', total);",
                  "",
                  "  pm.test('Calculated total is positive', function () {",
                  "    pm.expect(total).to.be.above(0);",
                  "  });",
                  "",
                  "  pm.test('Calculated total matches the expected total', function () {",
                  "    pm.expect(total).to.eql(Number(pm.environment.get('expected_seed_total')));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/carts/{{seed_cart_id}}",
            "description": ""
          }
        },
        {
          "name": "TC-10 Recalcular total del carrito creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "const quantity = Number(pm.environment.get('quantity'));",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Recalcula el total del carrito creado con los precios vigentes",
                  "let price_1 = null;",
                  "let price_2 = null;",
                  "for (const product of products) {",
                  "  if (product.id === Number(pm.environment.get('product_id'))) {",
                  "    price_1 = product.price;",
                  "  }",
                  "  if (product.id === Number(pm.environment.get('product_id_2'))) {",
                  "    price_2 = product.price;",
                  "  }",
                  "}",
                  "",
                  "pm.test('Both cart products still exist in the catalog', function () {",
                  "  pm.expect(price_1).to.not.be.null;",
                  "  pm.expect(price_2).to.not.be.null;",
                  "});",
                  "",
                  "pm.test('Total at checkout equals the total at cart creation', function () {",
                  "  const total = (price_1 * quantity + price_2).toFixed(2);",
                  "  pm.expect(total).to.eql(pm.environment.get('expected_cart_total'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products",
            "description": ""
          }
        }
      ]
    },
