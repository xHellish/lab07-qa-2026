            "url": "{{base_url}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC-11 Checkout con token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cart = pm.response.json();",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Request was sent with a Bearer token', function () {",
                  "  const auth_header = pm.request.headers.get('Authorization');",
                  "  pm.expect(auth_header).to.match(/^Bearer .+\\..+\\..+$/);",
                  "});",
                  "",
                  "pm.test('Confirmed cart has id and the selected products', function () {",
                  "  pm.expect(cart.id).to.be.a('number');",
                  "  pm.expect(cart.products).to.have.lengthOf(2);",
                  "});",
                  "",
                  "pm.test('Checkout total matches the expected total', function () {",
                  "  let total = 0;",
                  "  const prices = [Number(pm.environment.get('product_price')), Number(pm.environment.get('product_price_2'))];",
                  "  for (const [index, line] of cart.products.entries()) {",
                  "    total += prices[index] * line.quantity;",
                  "  }",
                  "  pm.expect(total.toFixed(2)).to.eql(pm.environment.get('expected_cart_total'));",
                  "});"
                ]
              }
            }
          ],
