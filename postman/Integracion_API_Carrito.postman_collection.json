  "item": [
    {
      "name": "Catálogo",
      "description": "Consulta de productos y validación de contrato.",
      "item": [
        {
          "name": "TC-01 Consultar catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is a non empty product list', function () {",
                  "  pm.expect(products).to.be.an('array');",
                  "  pm.expect(products.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Every product has id, title and numeric price', function () {",
                  "  for (const product of products) {",
                  "    pm.expect(product).to.have.property('id');",
                  "    pm.expect(product).to.have.property('title');",
                  "    pm.expect(product.price).to.be.a('number');",
                  "  }",
                  "});",
                  "",
                  "// Cada iteración usa productos distintos para variar los datos de prueba",
                  "const index = pm.info.iteration % (products.length - 1);",
                  "const first_product = products[index];",
                  "const second_product = products[index + 1];",
                  "pm.environment.set('product_id', first_product.id);",
                  "pm.environment.set('product_price', first_product.price);",
                  "pm.environment.set('product_title', first_product.title);",
                  "pm.environment.set('product_id_2', second_product.id);",
                  "pm.environment.set('product_price_2', second_product.price);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products",
            "description": "Consulta el catálogo y guarda dos productos en el environment."
          }
        },
        {
          "name": "TC-02 Consultar detalle de producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "const expected_id = Number(pm.environment.get('product_id'));",
                  "const expected_price = Number(pm.environment.get('product_price'));",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Product id matches the selected product', function () {",
                  "  pm.expect(product.id).to.eql(expected_id);",
                  "});",
                  "",
                  "pm.test('Product price matches the catalog price', function () {",
                  "  pm.expect(product.price).to.eql(expected_price);",
                  "});",
                  "",
                  "pm.test('Product title matches the catalog title', function () {",
                  "  pm.expect(product.title).to.eql(pm.environment.get('product_title'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products/{{product_id}}",
            "description": ""
          }
        },
        {
          "name": "TC-03 Contrato estricto de productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "const valid_categories = ['electronics', 'jewelery', \"men's clothing\", \"women's clothing\"];",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('id is an integer and title a non empty string', function () {",
                  "  for (const product of products) {",
                  "    pm.expect(Number.isInteger(product.id), 'id of ' + product.id).to.be.true;",
                  "    pm.expect(product.title).to.be.a('string').and.not.empty;",
                  "  }",
                  "});",
                  "",
                  "pm.test('price is a positive number', function () {",
                  "  for (const product of products) {",
                  "    pm.expect(product.price, 'price of ' + product.id).to.be.a('number').above(0);",
                  "  }",
                  "});",
                  "",
                  "pm.test('category is one of the known categories', function () {",
                  "  for (const product of products) {",
                  "    pm.expect(valid_categories, 'category of ' + product.id).to.include(product.category);",
                  "  }",
                  "});",
                  "",
                  "pm.test('image is an https URL', function () {",
                  "  for (const product of products) {",
                  "    pm.expect(product.image, 'image of ' + product.id).to.be.a('string').and.match(/^https:\\/\\//);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/products",
            "description": ""
          }
        },
